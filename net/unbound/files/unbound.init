#!/bin/sh /etc/rc.common
##############################################################################
#
# Copyright (C) 2016 Michael Hanselmann, Eric Luehrsen
#
##############################################################################
#
# This init script is just the entry point for Unbound UCI.
#
##############################################################################

# while useful (sh)ellcheck is pedantic and noisy
# shellcheck disable=1091,2002,2004,2034,2039,2086,2094,2140,2154,2155

START=19
STOP=50
USE_PROCD=1
PROG=/usr/sbin/unbound

##############################################################################

# boot 函数：在系统启动时调用
boot() {
  UB_BOOT=1         # 设置启动标志变量
  start "$@"        # 调用 start 函数，传递所有参数
}

##############################################################################

# procd 启动服务时调用的函数
start_service() {
  # 如果设置了 UB_BOOT 标志,说明已经在启动过程中了
  if [ -n "$UB_BOOT" ] ; then
    # Load procd triggers (rc) and use event IFUP to really start
    return 0
  fi

  # complex UCI work
  . /usr/lib/unbound/unbound.sh   # 加载 Unbound 的启动脚本
  unbound_start                   # 调用启动函数生成配置并准备启动

  # standard procd clause
  procd_open_instance "unbound"                                         # 打开 procd 实例，命名为 "unbound"
  procd_set_param command $PROG -d -c $UB_TOTAL_CONF                    # 设置要执行的命令
  procd_set_param respawn                                               # 设置进程崩溃时自动重启
  procd_set_param file "$UB_TOTAL_CONF" "$UB_SRV_CONF" "$UB_EXT_CONF"   # 监控这些配置文件变化
  procd_close_instance                                                  # 关闭 procd 实例
}

##############################################################################

# procd 停止服务时调用的函数
stop_service() {
  # clean up
  . /usr/lib/unbound/stopping.sh      # 加载 Unbound 的停止脚本
  unbound_stop                        # 调用停止函数执行清理操作

  # Wait! on restart Unbound may take time writing closure stats to syslog
  pidof $PROG && sleep 1              # 如果进程还在运行，等待1秒
}

##############################################################################

# 定义服务触发器
service_triggers() {
  local legacy1=$( uci_get unbound.@unbound[0].trigger )              # 获取旧的触发器配置1
  local legacy2=$( uci_get unbound.@unbound[0].trigger_interface )    # 旧的触发器配置2
  local legacy3=$( uci_get unbound.@unbound[0].iface_trig )           # 旧的触发器配置3
  local triggers="$legacy1 $legacy2 $legacy3"                         # 合并所有旧触发器配置

  . /usr/lib/unbound/defaults.sh      # 加载默认配置脚本


  if [ ! -f "$UB_TOTAL_CONF" ] || [ -n "$UB_BOOT" ] ; then
    # Unbound can be a bit heavy, so wait some on first start. Any interface
    # up affects the trigger delay and will guarantee start.

    # Unbound 启动可能较慢，首次启动时等待一下。任何接口启动都会触发重启
    # 添加原始触发器：任何网络接口启动时，延迟3000毫秒后重启unbound
    procd_add_raw_trigger "interface.*.up" 3000 /etc/init.d/unbound restart

  elif [ -n "$triggers" ] ; then
    for trigger in $triggers ; do
      # User selected triggers to restart at any other time
      # 用户选择的触发器在其他时间重启服务
      procd_add_reload_interface_trigger "$trigger"     # 添加接口重新加载触发器
    done

    procd_add_reload_trigger "unbound" "dhcp"           # 添加配置重载触发器：unbound或dhcp配置变化时

  else
    procd_add_reload_trigger "unbound" "dhcp"           # 默认触发器：unbound或dhcp配置变化时
  fi
}

##############################################################################

