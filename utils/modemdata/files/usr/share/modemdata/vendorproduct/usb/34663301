# 设置入网方式
function dial_net()
{
    local rat=""
    local ATCMD=""
    [ -n "$DIAL_PARAMS" ] && rat=$(echo "$DIAL_PARAMS" | jq -r '.rat // empty')
    [ ! -n "$rat" ] && logger -t "NCM" "Radio Access Technology(rat):${rat}" && return

    rat=$(echo "$rat" | tr a-z A-Z)
    echo "$rat"

    logger -t "NCM" "Radio Access Technology(rat):${rat}"

    # 避免重复设置
    query_net_settings
    [ "$rat" = "${SETTINGS_NET}" ] && echo "Radio Access Technology has not been changed! return..." && return

    # LTE
    [ "$rat" = "LTE" ] && {
        ATCMD='AT^SYSCFGEX=\"03\",3FFFFFFF,1,2,7FFFFFFFFFFFFFFF,,'
        O=$(sms_tool -D -d $DEVICE at ${ATCMD} | tr -d '\r')
        logger -t "NCM" "$ATCMD $O"

        if ! echo "$O" | grep -q "OK"; then
            echo "Error: AT^SYSCFGEX=\"03\",3FFFFFFF,1,2,7FFFFFFFFFFFFFFF,,"
        else
            echo "AT^SYSCFGEX=\"03\",3FFFFFFF,1,2,7FFFFFFFFFFFFFFF,, succeed"
        fi

        return
    }

    ATCMD="AT^C5GOPTION?"
    O=$(sms_tool -D -d $DEVICE at ${ATCMD} | tr -d '\r')
    
    logger -t "NCM" "$ATCMD $O"

    local awk_output=$(echo "$O" | awk -F'[,:]+' '/C5GOPTION/{gsub(/^[ \t]+|[ \t]+$/, "", $2); printf "nr_sa_support_flag=%s nr_dc_mode=%s c5g_access_mode=%s",$2,$3,$4}')

    # SA only
    [ "$rat" = "SA" ] && {

        # 入网优先级,仅允许NR
        ATCMD='AT^SYSCFGEX=\"08\",3FFFFFFF,1,2,7FFFFFFFFFFFFFFF,,'
        O=$(sms_tool -D -d $DEVICE at $ATCMD | tr -d '\r')

        logger -t "NCM" "$ATCMD $O"

        if ! echo "$O" | grep -q "OK"; then
            echo "Error: AT^SYSCFGEX=\"08\",3FFFFFFF,1,2,7FFFFFFFFFFFFFFF,,"
        else
            echo "set AT^SYSCFGEX=\"08\",3FFFFFFF,1,2,7FFFFFFFFFFFFFFF,, succeed"
        fi

        # 本来就是SA only, 不必重复设置
        [ x"nr_sa_support_flag" = "x1" ] && [ x"nr_dc_mode" = "x0" ] && [ x"c5g_access_mode" = "x1" ] && { 
            logger -t "NCM" "Radio Access Technology(rat): SA only"    
            echo "Already in SA only" && return 
        }

        # 飞行模式开
        ATCMD="AT+CFUN=0"
        O=$(sms_tool -D -d $DEVICE at ${ATCMD} | tr -d '\r')

        logger -t "NCM" "$ATCMD $O"

        if ! echo "$O" | grep -q "OK"; then
            echo "Error: Failed to set AT+CFUN=0"
        else
            echo "set AT+CFUN=0 succeed"
        fi

        # 设置SA only
        ATCMD="AT^C5GOPTION=1,0,1"
        O=$(sms_tool -D -d $DEVICE at "AT^C5GOPTION=1,0,1" | tr -d '\r')

        logger -t "NCM" "$ATCMD $O"

        if ! echo "$O" | grep -q "OK"; then
            echo "Error: Failed to set C5GOPTION SA"
        else
            echo "set C5GOPTION SA succeed"
            logger -t "NCM" "Radio Access Technology(rat): set to SA only success" 
        fi

        # 飞行模式关,并触发软重启
        ATCMD="AT+CFUN=1"
        O=$(sms_tool -D -d $DEVICE at $ATCMD | tr -d '\r')

        logger -t "NCM" "$ATCMD $O"

        if ! echo "$O" | grep -q "OK"; then
            echo "Error: Failed to set AT+CFUN=1,1"
        else
            echo "set AT+CFUN=1,1 succeed"
        fi

        return
    }

    # SA + NSA
    [ "$rat" = "SA+NSA" ] && {

        # 入网优先级,允许NR+LTE
        ATCMD='AT^SYSCFGEX=\"0803\",3FFFFFFF,1,2,7FFFFFFFFFFFFFFF,,'
        O=$(sms_tool -D -d $DEVICE at ${ATCMD} | tr -d '\r')

        logger -t "NCM" "$ATCMD $O"

        if ! echo "$O" | grep -q "OK"; then
            echo "Error: AT^SYSCFGEX=\"0803\",3FFFFFFF,1,2,7FFFFFFFFFFFFFFF,,"
        else
            echo "AT^SYSCFGEX=\"0803\",3FFFFFFF,1,2,7FFFFFFFFFFFFFFF,, succeed"
        fi

        # 本来就是SA+NSA, 不必重复设置
        [ x"nr_sa_support_flag" = "x1" ] && [ x"nr_dc_mode" = "x1" ] && [ x"c5g_access_mode" = "x1" ] && {
            logger -t "NCM" "Radio Access Technology(rat): SA+NSA" 
            echo "Already in SA+NSA" && return 
        }

        # 飞行模式开
        ATCMD="AT+CFUN=0"
        O=$(sms_tool -D -d $DEVICE at $ATCMD | tr -d '\r')

        logger -t "NCM" "$ATCMD $O"

        if ! echo "$O" | grep -q "OK"; then
            echo "Error: Failed to set AT+CFUN=0"
        else
            echo "set AT+CFUN=0 succeed"
        fi

        # 设置SA + NSA
        ATCMD="AT^C5GOPTION=1,1,1"
        O=$(sms_tool -D -d $DEVICE at $ATCMD | tr -d '\r')

        logger -t "NCM" "$ATCMD $O"

        if ! echo "$O" | grep -q "OK"; then
            echo "Error: Failed to set C5GOPTION SA+NSA"
        else
            echo "set C5GOPTION SA+NSA succeed"
            logger -t "NCM" "Radio Access Technology(rat): set SA+NSA success" 
        fi

        # 飞行模式关,并触发软重启
        ATCMD="AT+CFUN=1"
        O=$(sms_tool -D -d $DEVICE at $ATCMD | tr -d '\r')

        logger -t "NCM" "$ATCMD $O"

        if ! echo "$O" | grep -q "OK"; then
            echo "Error: Failed to set AT+CFUN=1"
        else
            echo "set AT+CFUN=1 succeed"
        fi

        return
    }

    # NSA only
    [ "$rat" = "NSA" ] && {

        # 入网优先级,允许NR+LTE
        ATCMD='AT^SYSCFGEX=\"0803\",3FFFFFFF,1,2,7FFFFFFFFFFFFFFF,,'
        O=$(sms_tool -D -d $DEVICE at $ATCMD | tr -d '\r')

        logger -t "NCM" "$ATCMD $O"

        if ! echo "$O" | grep -q "OK"; then
            echo "Error: Failed to SYSCFGEX 0803"
        else
            echo "set SYSCFGEX to 0803 succeed"
        fi

        # 本来就是NSA only, 不必重复设置
        [ x"nr_sa_support_flag" = "x0" ] && [ x"nr_dc_mode" = "x1" ] && [ x"c5g_access_mode" = "x0" ] && {
            logger -t "NCM" "Radio Access Technology(rat): NSA only" 
            echo "Already in NSA only" && return 
        }

        # 飞行模式开
        ATCMD="AT+CFUN=0"
        O=$(sms_tool -D -d $DEVICE at $ATCMD | tr -d '\r')

        logger -t "NCM" "$ATCMD $O"

        if ! echo "$O" | grep -q "OK"; then
            echo "Error: Failed to set AT+CFUN=0"
        else
            echo "set AT+CFUN=0 succeed"
        fi

        # 设置NSA only
        ATCMD="AT^C5GOPTION=0,1,0"
        O=$(sms_tool -D -d $DEVICE at $ATCMD | tr -d '\r')

        logger -t "NCM" "$ATCMD $O"

        if ! echo "$O" | grep -q "OK"; then
            echo "Error: Failed to set C5GOPTION NSA only"
        else
            logger -t "NCM" "Radio Access Technology(rat): set NSA only success" 
            echo "set C5GOPTION NSA only succeed"
        fi

        # 飞行模式关,并触发软重启
        ATCMD="AT+CFUN=1"
        O=$(sms_tool -D -d $DEVICE at $ATCMD | tr -d '\r')

        logger -t "NCM" "$ATCMD $O"

        if ! echo "$O" | grep -q "OK"; then
            echo "Error: Failed to set AT+CFUN=1"
        else
            echo "set AT+CFUN=1 succeed"
        fi

        return
    }
}

# 设置鉴权
function dial_auth()
{
    local auth=""
    local passwd="" 
    local username=""
    local ATCMD=""

    # 先设置无鉴权
    ATCMD="AT^AUTHDATA=1,0,"
    O=$(sms_tool -D -d $DEVICE at "${ATCMD}" | tr -d '\r')

    logger -t "NCM" "$ATCMD $O"

    [ -n "$DIAL_PARAMS" ] && auth=$(echo "$DIAL_PARAMS" | jq -r '.auth // empty')
    [ ! -n "$auth" ] && logger -t "NCM" "auth is empty! return..." && return
    [ -n "$DIAL_PARAMS" ] && passwd=$(echo "$DIAL_PARAMS" | jq -r '.passwd // empty')
    [ ! -n "$passwd" ] && logger -t "NCM" "auth password is empty! return..." && return
    [ -n "$DIAL_PARAMS" ] && username=$(echo "$DIAL_PARAMS" | jq -r '.username // empty')
    [ ! -n "$username" ] && logger -t "NCM" "auth username is empty! return..." && return

    auth=$(echo "$auth" | tr a-z A-Z)

    [ "$auth" = "PAP" ] && ATCMD="AT^AUTHDATA=1,1,\"\",\"$passwd\",\"$username\""
    [ "$auth" = "CHAP" ] && ATCMD="AT^AUTHDATA=1,2,\"\",\"$passwd\",\"$username\""
    [ "$auth" = "NONE" ] && ATCMD="AT^AUTHDATA=1,0,"

    O=$(sms_tool -D -d $DEVICE at "${ATCMD}" | tr -d '\r')

    logger -t "NCM" "$ATCMD $O"

    if ! echo "$O" | grep -q "OK"; then
        echo "Error: Failed to set ${ATCMD}"
    else
        echo "Set ${ATCMD} succeed"
    fi
}

# 锁5G频段 不锁频点 不锁PCI小区
function dial_NRBANDLOCK()
{   
    local NRLOCKPARAMS=$1
    local NRBAND=""
    local NRBAND_COUNT=0
    echo ${NRLOCKPARAMS}
