# 从一个串口/控制口设备名快速定位对应的调制解调器硬件型号
# 不同类型设备节点在 sysfs 的挂载位置不同：/sys/class/tty、/sys/class/wwan、/sys/class/usbmisc 等
# PCI 设备用 vendor/device（带 0x 前缀），USB 设备用 idVendor/idProduct（一般不带 0x）
getdevicevendorproduct() {
	devname="$(basename $1)"						# 取第1个参数的“基名”：/dev/ttyUSB0 -> ttyUSB0；ttyUSB0 -> ttyUSB0

	# 按设备名模式匹配，不同类型走不同 sysfs 路径
	case "$devname" in
		# 例如 mhi_DUN0：常见于 MHI（Modem Host Interface）暴露的 DUN 设备（多为 PCIe 调制解调器）
		'mhi_DUN'*)
			devpath=$(find /sys/devices -name "$devname" -type d 2>/dev/null | head -1)	# 在 /sys/devices 下搜索同名目录，取第一个匹配项作为设备路径（忽略错误输出）
			T=${devpath%/*/*/*}
			if [ -e $T/vendor ] && [ -e $T/device ]; then
				V=$(cat $T/vendor)
				D=$(cat $T/device)
				echo "pci/${V/0x/}${D/0x/}"
			fi
			;;
		# 例如 wwan0at0：Linux WWAN 框架下的 AT 端口（很多 PCIe/部分平台）
		'wwan'*'at'*)
			devpath="$(readlink -f /sys/class/wwan/$devname/device)"			# 从 /sys/class/wwan/<devname>/device 解析真实设备路径（跟随符号链接）
			T=${devpath%/*/*/*}
			if [ -e $T/vendor ] && [ -e $T/device ]; then
				V=$(cat $T/vendor)
				D=$(cat $T/device)
				echo "pci/${V/0x/}${D/0x/}"
			fi
			;;
		# 例如 ttyACM0：USB CDC ACM 设备（常见于某些调制解调器的控制口）
		'ttyACM'*)
			devpath="$(readlink -f /sys/class/tty/$devname/device)"				# 从 /sys/class/tty/<ttyACM*>/device 找到真实 sysfs 设备路径
			T=${devpath%/*}
			echo "usb/$(cat $T/idVendor)$(cat $T/idProduct)"
			;;
		# 例如 ttyUSB0、ttyUSB1：USB 串口（常见于 USB 调制解调器的多个串口）
		'tty'*)
			devpath="$(readlink -f /sys/class/tty/$devname/device)"				# 解析该 tty 设备在 sysfs 的真实路径
			T=${devpath%/*/*}
			echo "usb/$(cat $T/idVendor)$(cat $T/idProduct)"
			;;
		# 其他设备名（例如某些 /dev/usbmisc/* 节点：qmi/mbim/其他控制接口）
		*)
			devpath="$(readlink -f /sys/class/usbmisc/$devname/device)"			
			T=${devpath%/*}
			echo "usb/$(cat $T/idVendor)$(cat $T/idProduct)"
			;;
	esac
}
