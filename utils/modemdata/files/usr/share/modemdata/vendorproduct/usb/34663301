function dial()
{
    logger -t "NCM" "$0" "$@"

    local ATCMD=""

    init                # 确保模组的基本设置正确
    dial_net            # 入网方式设置
    dial_apn            # 拨号时设置APN
    dial_auth           # 鉴权设置
    dial_NRFREQLOCK     # 锁5G频段 PCI小区
    dial_LTEFREQLOCK    # 锁4G频段 PCI小区

    # 必须先断开连接才能激活PDP上下文
    ATCMD="AT^NDISDUP=1,0"
    O=$(sms_tool -D -d $DEVICE at "${ATCMD}" | tr -d '\r')
    logger -t "NCM" "$ATCMD" "$O"

    # 执行拨号指令
    ATCMD="AT^NDISDUP=1,1"
    O=$(sms_tool -D -d $DEVICE at "${ATCMD}" | tr -d '\r')
    logger -t "NCM" "$ATCMD" "$O"

    if ! echo "$O" | grep -q "OK"; then
        echo "Error: ${ATCMD} Reply:${O}"
    else
        echo "${ATCMD} succeed"
    fi
}


